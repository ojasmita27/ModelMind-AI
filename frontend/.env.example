# Optional. Copy to ".env.local" only if you need to change these. No secrets belong here:
# every VITE_* value is embedded in the browser bundle and is publicly readable.

# Where the Vite dev server forwards /api requests (default shown).
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Base URL the browser uses for the API. Default "/api/v1" (same origin via the proxy / a reverse proxy).
# Set a full URL only when the API is on another origin, e.g. https://api.example.com/api/v1
# (then add the frontend origin to CORS_ORIGINS in the backend .env).
# VITE_API_BASE_URL=/api/v1
