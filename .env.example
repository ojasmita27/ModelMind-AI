# ModelMind AI configuration.
# Copy this file to ".env" in the project root (PowerShell:  Copy-Item .env.example .env)
# NEVER commit or share your real .env. It is listed in .gitignore.

# ======================================================================
# REQUIRED
# ======================================================================
# Secret used to sign login tokens (min. 32 characters). The app refuses to start while
# this still contains "CHANGE_ME". Generate one:
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
# (scripts\setup-local.ps1 does this for you.)
SECRET_KEY=CHANGE_ME_generate_a_random_value_of_32_or_more_characters

# ======================================================================
# DATABASE: use exactly ONE DATABASE_URL line
# ======================================================================
# Option A (default): SQLite file. LOCAL DEVELOPMENT ONLY. No Docker or PostgreSQL needed.
# Relative paths are resolved from the project root. The folder is created automatically.
DATABASE_URL=sqlite:///./data/modelmind_dev.db

# Option B: PostgreSQL (intended for deployment). Comment out Option A, uncomment the lines
# below and replace CHANGE_ME_... with a password of letters and digits only (no @ : / # %).
# The same password must appear in POSTGRES_PASSWORD and in DATABASE_URL.
# Needs Docker Desktop running (which needs WSL 2 on Windows) or any PostgreSQL 14+ server.
# POSTGRES_USER=modelmind
# POSTGRES_PASSWORD=CHANGE_ME_use_letters_and_digits_only
# POSTGRES_DB=modelmind
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://modelmind:CHANGE_ME_use_letters_and_digits_only@localhost:5432/modelmind

# ======================================================================
# OPTIONAL
# ======================================================================
# development | test | production. "production" refuses SQLite.
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated browser origins allowed to call the API directly. Not needed in local dev,
# because the Vite proxy makes the browser talk to a single origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# text (readable) or json (for log collectors)
LOG_FORMAT=text

# Tests use a throwaway SQLite file by default and never touch DATABASE_URL.
# To run the suite against PostgreSQL instead, create a SEPARATE database whose name ends in
# "_test" (docker/postgres/init.sql creates "modelmind_test") and set:
# TEST_DATABASE_URL=postgresql+psycopg://modelmind:CHANGE_ME_use_letters_and_digits_only@localhost:5432/modelmind_test
